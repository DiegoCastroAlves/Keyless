<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scanning QR codes (two-step verification setups, setup codes). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- "Code copied" after filling a login with a one-time password (asked on the autofill check screen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Running until that code leaves the clipboard (ClipboardClearService, 90 seconds). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Whether Chrome lets another autofill service fill (the autofill check screen);
         apps' names, for the title of a login saved from them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
    </queries>

    <application
        android:name=".KeylessApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyless"
        android:usesCleartextTraffic="${cleartext}">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Setup codes: keyless://setup#email=…&key=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="keyless" android:host="setup" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AutofillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- A login with a one-time password, chosen in the autofill list. -->
        <activity
            android:name=".AutofillFillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Keyless.Translucent"
            android:windowSoftInputMode="adjustResize" />

        <!-- Also Android's autofill settings' gear (xml/autofill_service.xml). -->
        <activity
            android:name=".AutofillCheckActivity"
            android:exported="true"
            android:label="@string/check_title" />

        <receiver
            android:name=".ClipboardClearReceiver"
            android:exported="false" />

        <service
            android:name=".ClipboardClearService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <activity
            android:name=".QrScanActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PasskeyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Passkeys for apps and websites (Android 14 and later). -->
        <service
            android:name=".KeylessCredentialService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <service
            android:name=".KeylessAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
