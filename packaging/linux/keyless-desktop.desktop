[Desktop Entry]
Type=Application
Name=Keyless
GenericName=Password Manager
GenericName[es]=Gestor de contraseñas
Comment=Zero-knowledge password manager
Comment[es]=Gestor de contraseñas de conocimiento cero
Exec=keyless-desktop
Icon=keyless-desktop
StartupWMClass=keyless-desktop
Terminal=false
Categories=Utility;Security;
Keywords=password;passwords;vault;login;2fa;totp;
Actions=QuickAccess;Fill;Show;Lock;

# Installed again in share/kglobalaccel, so KDE binds this shortcut by default
# (System Settings > Shortcuts > Keyless to change it).
[Desktop Action QuickAccess]
Name=Quick Access
Name[es]=Acceso rápido
Exec=keyless-desktop --quick-access
X-KDE-Shortcuts=Ctrl+Shift+Space

# In a browser, fills the page through the Keyless extension; in other apps,
# opens Quick Access to type a login (Auto-Type).
[Desktop Action Fill]
Name=Fill or type
Name[es]=Rellenar o escribir
Name[pt_BR]=Preencher ou digitar
Exec=keyless-desktop --fill
X-KDE-Shortcuts=Ctrl+\\

[Desktop Action Show]
Name=Show Keyless
Name[es]=Mostrar Keyless
Name[pt_BR]=Mostrar o Keyless
Exec=keyless-desktop --show
X-KDE-Shortcuts=

[Desktop Action Lock]
Name=Lock Keyless
Name[es]=Bloquear Keyless
Name[pt_BR]=Bloquear o Keyless
Exec=keyless-desktop --lock
X-KDE-Shortcuts=
